---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';

// Placeholder resume content — replace every entry with the real record.
const experience = [
  {
    company: 'DELL',
    title: 'Director - Applied AI',
    range: '2026 — Present',
    location: 'Austin, TX',
    bullets: [
      'Architecting and deploying a custom AI orchestration platform across the product organization, using a purpose-built agent harness to automate software development workflows and drive a 10-15x increase in developer velocity versus off-the-shelf AI IDEs.',
      'Extending AI agents beyond software development into the physical product lifecycle, integrating agents with hardware, cameras, and debug testbeds to automate real-world validation and feedback loops.',
      'Founded and scaled the Applied AI organization, establishing a high-ownership "build and iterate" culture and creating a startup-like operating model within a Fortune 500.'
    ],
  },
  {
    company: 'DELL',
    title: 'Senior Engineering Manager - Dell Pro AI Studio',
    range: '2024 — 2026',
    location: 'Austin, TX',
    bullets: [
      'Built Dell Pro AI Studio, a first-of-its-kind developer platform for AI application development across Dell\'s AI PC ecosystem; took the product from proof of concept to production launch in six months and drove customer adoption shortly after launch.',
      'Operated as a hands-on product and engineering leader through significant ambiguity—defined the MVP, made architecture and prioritization tradeoffs, and continued contributing production code, debugging issues, and working directly with developers.',
      'Owned the product narrative across executives and cross-functional partners, translating technical capabilities into a product strategy for marketing, sales, support, and CTO leadership; represented the platform as a flagship AI initiative at Dell Technologies World.',
      'Built and mentored the engineering team, including new graduates and interns, establishing a high-ownership "build and iterate" culture focused on rapid experimentation, technical rigor, and customer feedback.'
    ],
  },
    {
    company: 'DELL',
    title: 'Engineering Manager - Dell Trusted Device',
    range: '2021 — 2024',
    location: 'Austin, TX',
    bullets: [
      'Led the team building industry first cloud-based supply-chain verification product, enabling customers to validate device integrity at delivery while creating a recurring-revenue opportunity and first-to-market differentiator.',
      'Owned the product lifecycle from strategy through delivery, translating customer and business needs into roadmap priorities and shipping features while remaining hands-on in architecture and technical reviews.',
      'Partnered directly with product and customers to shape security capabilities and roadmap priorities, balancing customer value, technical feasibility, and delivery speed.'
    ],
  },
    {
    company: 'DELL',
    title: 'Senior Software Engineer - Firmware Security Solutions',
    range: '2019 — 2021',
    location: 'Austin, TX',
    bullets: [
      'Spearheaded a major overhaul of BIOS and firmware code-signing infrastructure, designing signing tools and strengthening CI/CD pipelines to reduce release risk and improve the resilience and reliability of security updates.'
    ],
  },
    {
    company: 'DELL',
    title: 'Software Engineer - Firmware Security',
    range: '2017 — 2019',
    location: 'Austin, TX',
    bullets: [
      'Led a five-engineer team hardening BIOS to support Intel Runtime BIOS Resilience and Microsoft SystemGuard, contributing to Intel showcasing the Latitude 7400 at Computex and calling it "the latest in commercial system design.'
    ],
  },
];

const beyondWork = [
  'Certified Information Systems Security Professional (CISSP), September 2021',
  'Achieved rank of Eagle Scout, March 2012',
  'Developed a rudimentary computer vision system to improve medication adherence',
  'On a quest to visit all 63 U.S. national parks.',
];

const education = {
  school: 'University of Michigan',
  degree: 'B.S Computer Engineering, Minor in Business',
  range: '2013 — 2017',
};
---

<BaseLayout title="Resume" description="Resume of Sharvil Patel, software engineer.">
  <div class="pad">
    <header class="resume-header">
      <div>
        <h1>Sharvil Patel</h1>
        <p class="mono-label contact-strip">
          <a href="mailto:sharvilpatel95@gmail.com">sharvilpatel95@gmail.com</a> &middot;
          <a href="https://github.com/sharvil6">github.com/sharvil6</a> &middot;
          sharvilpatel.dev
        </p>
      </div>
      <a class="download mono-label no-print" href="/resume/sharvil-patel-resume.pdf" download>
        Download PDF &darr;
      </a>
    </header>

    <section class="section">
      <SectionHeading index="01" title="Experience" />
      {
        experience.map((job) => (
          <article class="job">
            <div class="job-head">
              <h3>{job.title} &middot; {job.company}</h3>
              <p class="mono-label">{job.range} &middot; {job.location}</p>
            </div>
            <ul>
              {job.bullets.map((line) => (
                <li>{line}</li>
              ))}
            </ul>
          </article>
        ))
      }
    </section>

    <section class="section">
      <SectionHeading index="04" title="Education" />
      <div class="job-head">
        <h3>{education.degree} &middot; {education.school}</h3>
        <p class="mono-label">{education.range}</p>
      </div>
    </section>

    <section class="section">
      <SectionHeading index="02" title="Projects" />
      <p class="prose">
        Selected personal projects with full writeups:
        <a href="/projects/ai-orchestration-platform">AI Orchestration Platform</a>,
        <a href="/projects/hestia-recipe-share">Hestia</a>, and
        <a href="/projects/ynab-tracking-account">YNAB Tracking Accounts</a>.
      </p>
    </section>

    <section class="section">
      <SectionHeading index="03" title="Beyond Work" />
      <ul class="prose beyond-list">
        {beyondWork.map((item) => <li>{item}</li>)}
      </ul>
    </section>


  </div>
</BaseLayout>

<style>
  .resume-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: var(--s3);
    padding-block: var(--s8) var(--s4);
  }

  h1 {
    font-size: var(--text-2xl);
  }

  .contact-strip {
    margin-block-start: var(--s1);
  }

  .download {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    color: var(--accent);
    border: var(--hairline);
    border-color: color-mix(in oklch, var(--accent) 40%, var(--line));
    padding: var(--s1) var(--s3);
    border-radius: 4px;
    transition: background 0.2s var(--ease-out);
  }

  .download:hover {
    background: color-mix(in oklch, var(--accent) 10%, transparent);
  }

  .section {
    padding-block: var(--s4) var(--s6);
  }

  .job + .job {
    margin-block-start: var(--s4);
    border-top: var(--hairline);
    padding-block-start: var(--s4);
  }

  .job-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: var(--s1) var(--s3);
  }

  h3 {
    font-size: var(--text-lg);
  }

  .job ul {
    margin-block-start: var(--s2);
    padding-inline-start: 1.25em;
    max-width: var(--measure);
  }

  .job li + li {
    margin-block-start: var(--s1);
  }

  .beyond-list {
    padding-inline-start: 1.25em;
    max-width: var(--measure);
  }

  .beyond-list li + li {
    margin-block-start: var(--s1);
  }
</style>
